from datetime import datetime, timezone
from sqlalchemy import (
    Column,
    Integer,
    String,
    Numeric,
    Date,
    ForeignKey,
    Text
)

from sqlalchemy.orm import relationship

from app.db.database import Base


class Expense(Base):

    __tablename__ = "expenses"

    # Unique expense ID
    id = Column(
        Integer,
        primary_key=True,
        index=True
    )

    # Which user created this expense?
    user_id = Column(
        Integer,
        ForeignKey("users.id"),
        nullable=False,
        index=True
    )

    # Expense amount
    amount = Column(
        Numeric(10, 2),
        nullable=False
    )

    # Expense category
    category = Column(
        String(50),
        nullable=False
    )

    # Optional description
    description = Column(
        Text,
        nullable=True
    )

    # Date of expense
    expense_date = Column(
        Date,
        nullable=False
    )
    created_at = Column(
    DateTime(timezone=True),
    default=lambda: datetime.now(timezone.utc),
    nullable=False
)
 # Relationship back to user
    user = relationship(
        "User",
        back_populates="expenses"
    )
